        DEPLOY_PATH = '/var/www/html/mywebsite/balaji'
        BACKUP_BASE = '/var/tmp/backups'
        TARBALL = 'changes.tar.gz'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/balaji-stack/balaji.git'
            }
        }

        stage('Check Changes and Create Tar') {
            steps {
                script {
                    sh '''
                    PREV_COMMIT=$(git rev-parse HEAD~1)
                    CURR_COMMIT=$(git rev-parse HEAD)

                    echo "Checking file status using stat:"
                    stat index.html || true

                    git diff --name-only $PREV_COMMIT $CURR_COMMIT > changed_files.txt || echo ""

                    echo "Changed files:"
                    cat changed_files.txt

                    if grep -q "^index.html$" changed_files.txt; then
                        tar -czf $TARBALL index.html
                        echo "index.html updated and packaged."
                    else
                        echo "No relevant changes to package. Exiting build early."
                        rm -f $TARBALL
                        exit 0
                    fi
                    '''
                }
            }
        }

        stage('Backup and Deploy') {
            when {
                expression {
                    // Proceed only if the tarball exists
                    return fileExists(env.TARBALL)
                }
            }
            steps {
                script {
                    sh '''
                    TIMESTAMP=$(date +%F_%H-%M-%S)
                    BACKUP_TAR="$BACKUP_BASE/balaji-backup_$TIMESTAMP.tar.gz"

                    # Ensure backup directory exists
                    sudo mkdir -p "$BACKUP_BASE"

                    # Backup the entire balaji directory
                    if [ -d "$DEPLOY_PATH" ]; then
                        sudo tar -czf "$BACKUP_TAR" -C "$(dirname "$DEPLOY_PATH")" "$(basename "$DEPLOY_PATH")"
                        echo "Backup of balaji directory created at $BACKUP_TAR"
                    else
                        echo "Directory $DEPLOY_PATH not found for backup."

pipeline {
    agent any

    environment {
        DEPLOY_PATH = '/var/www/html/mywebsite/balaji'
        BACKUP_BASE = '/var/tmp/backups'
        TARBALL = 'changes.tar.gz'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/balaji-stack/balaji.git'
            }
        }

        stage('Create Incremental Tar') {
            steps {
                script {
                    sh '''
                    PREV_COMMIT=$(git rev-parse HEAD~1)
                    CURR_COMMIT=$(git rev-parse HEAD)

                    git diff --name-only $PREV_COMMIT $CURR_COMMIT > changed_files.txt || echo ""

                    echo "Changed files:"
                    cat changed_files.txt

                    if grep -q "^index.html$" changed_files.txt; then
                        tar -czf $TARBALL index.html
                        echo "index.html updated and packaged."
                    else
                        echo "No relevant changes to package."
                        rm -f $TARBALL
                    fi
                    '''
                }
            }
        }

        stage('Deploy to Apache Server') {
            steps {
                script {
                    sh '''
                    if [ -f "$TARBALL" ]; then
                        TIMESTAMP=$(date +%F_%H-%M-%S)
                        BACKUP_TAR="$BACKUP_BASE/index-backup_$TIMESTAMP.tar.gz"

                        # Ensure backup directory exists
                        sudo mkdir -p "$BACKUP_BASE"

                        # Create timestamped tar.gz backup
                        if [ -f "$DEPLOY_PATH/index.html" ]; then
                            sudo tar -czf "$BACKUP_TAR" -C "$DEPLOY_PATH" index.html
                            echo "Backup of index.html created at $BACKUP_TAR"
                        else
                            echo "No existing index.html to backup"
                        fi

                        # Deploy new changes
                        sudo tar -xzf "$TARBALL" -C "$DEPLOY_PATH"
                        sudo chown -R www-data:www-data $DEPLOY_PATH
                        sudo chmod -R 755 $DEPLOY_PATH
                        sudo systemctl restart apache2
                        echo "Deployment complete."
                    else
                        echo "No changes detected. Deployment skipped."
                    fi
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '*.tar.gz', fingerprint: true
        }
    }
}


